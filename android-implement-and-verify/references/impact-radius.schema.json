{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "impact-radius.schema.json",
  "title": "Android Delivery Incremental Impact Radius",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "requirement_id",
    "requirement_revision",
    "requirement_file_sha256",
    "requirement_summary_sha256",
    "allowed_files",
    "allowed_dirs",
    "impacts"
  ],
  "properties": {
    "version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "requirement_id": { "type": "string", "minLength": 1 },
    "requirement_revision": { "type": "integer", "minimum": 1 },
    "requirement_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirement_summary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "allowed_files": {
      "type": "array",
      "description": "精确文件白名单；每项必须被某个 impacts[].expected_files 解释。",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "allowed_dirs": {
      "type": "array",
      "description": "目录前缀列表，每项必须以 / 结尾且禁止通配符；最终实际文件仍需被 impacts[].expected_files 精确或目录前缀解释。",
      "items": { "type": "string", "pattern": "^[^*?\\[\\]]*/$" },
      "uniqueItems": true
    },
    "no_code_change_reason": { "type": "string", "minLength": 1 },
    "impacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/impact" }
    }
  },
  "$defs": {
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "change_type",
        "reason",
        "expected_files",
        "expected_tests",
        "affected_modules"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^BDD-[0-9]+$" },
        "change_type": {
          "enum": ["ADDED", "CHANGED", "REMOVED", "SUPERSEDED"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "expected_files": {
          "type": "array",
          "description": "该义务解释的预期文件；需要覆盖目录时可使用以 / 结尾的目录前缀。",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "expected_tests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "affected_modules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "no_code_change_reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
