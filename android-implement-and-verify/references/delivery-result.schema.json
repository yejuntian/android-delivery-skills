{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-result.schema.json",
  "title": "Android Delivery Final Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requirement_id",
    "requirement_revision",
    "baseline_id",
    "requirement_file_sha256",
    "requirement_inputs_sha256",
    "snapshot_sha256",
    "conclusion",
    "pending_capabilities",
    "obligations",
    "gates",
    "evidence"
  ],
  "properties": {
    "version": { "const": 4 },
    "requirement_id": { "type": "string", "minLength": 1 },
    "requirement_revision": { "type": "integer", "minimum": 1 },
    "baseline_id": { "type": "string", "minLength": 1 },
    "requirement_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirement_inputs_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conclusion": {
      "enum": ["FULL_PASS", "LOCAL_PASS_DEVICE_PENDING", "INCOMPLETE", "BLOCKED"]
    },
    "pending_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requires_device", "reason", "evidence_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requires_device": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "obligation_sha256", "status", "evidence_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^BDD-[0-9]+/T[0-9]+$" },
          "required": { "type": "boolean" },
          "obligation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": {
            "enum": ["COVERED_AUTOMATED", "COVERED_MANUAL", "UNVERIFIED", "BLOCKED", "NOT_APPLICABLE"]
          },
          "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "reason": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "status", "evidence_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "enum": ["PASS", "FAIL", "SKIPPED", "UNVERIFIED", "BLOCKED"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "reason": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "snapshot_sha256", "obligation_sha256s"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["AUTOMATED", "AGENT", "MANUAL", "REVIEW"] },
          "gate_id": {
            "enum": [
              "android-test-and-fix",
              "android-build",
              "android-lint",
              "android-static-analysis",
              "android-verify-api-contract",
              "android-data-migration",
              "android-ui-a11y",
              "android-security-privacy",
              "android-dynamic-leak",
              "android-performance"
            ]
          },
          "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "exit_code": { "type": "integer" },
          "executed_tests": { "type": "integer", "minimum": 0 },
          "receipt_path": { "type": "string", "minLength": 1 },
          "receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "specialist": { "type": "string", "minLength": 1 },
          "specialist_result_path": { "type": "string", "minLength": 1 },
          "specialist_result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "summary": { "type": "string" },
          "report_paths": { "type": "array", "items": { "type": "string" } },
          "obligation_test_cases": {
            "type": "object",
            "propertyNames": { "pattern": "^BDD-[0-9]+/T[0-9]+$" },
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "executor": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 },
          "performed_at": { "type": "string", "format": "date-time" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "expected", "actual", "status"],
              "properties": {
                "action": { "type": "string", "minLength": 1 },
                "expected": { "type": "string", "minLength": 1 },
                "actual": { "type": "string", "minLength": 1 },
                "status": { "enum": ["PASS", "FAIL", "BLOCKED"] }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "kind": { "type": "string" }
              }
            }
          },
          "no_artifact_reason": { "type": "string", "minLength": 1 },
          "obligation_sha256s": {
            "type": "object",
            "propertyNames": { "pattern": "^BDD-[0-9]+/T[0-9]+$" },
            "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "AUTOMATED" } }, "required": ["kind"] },
            "then": {
              "required": [
                "command",
                "gate_id",
                "exit_code",
                "receipt_path",
                "receipt_sha256",
                "report_paths",
                "obligation_test_cases"
              ]
            }
          },
          {
            "if": {
              "properties": { "kind": { "enum": ["AGENT", "REVIEW"] } },
              "required": ["kind"]
            },
            "then": {
              "required": [
                "summary",
                "specialist",
                "specialist_result_path",
                "specialist_result_sha256"
              ]
            }
          },
          {
            "if": { "properties": { "kind": { "const": "AGENT" } }, "required": ["kind"] },
            "then": {
              "required": ["executed_tests"],
              "properties": {
                "specialist": { "const": "android-test-and-fix/journey-agent" }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "MANUAL" } }, "required": ["kind"] },
            "then": {
              "required": [
                "summary",
                "gate_id",
                "executor",
                "environment",
                "performed_at",
                "steps",
                "artifacts"
              ],
              "anyOf": [
                { "properties": { "artifacts": { "minItems": 1 } } },
                { "required": ["no_artifact_reason"] }
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "conclusion": { "const": "FULL_PASS" } },
        "required": ["conclusion"]
      },
      "then": {
        "properties": { "pending_capabilities": { "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": { "conclusion": { "const": "LOCAL_PASS_DEVICE_PENDING" } },
        "required": ["conclusion"]
      },
      "then": {
        "properties": {
          "pending_capabilities": {
            "minItems": 1,
            "contains": {
              "properties": { "requires_device": { "const": true } },
              "required": ["requires_device"]
            }
          }
        }
      }
    }
  ]
}
