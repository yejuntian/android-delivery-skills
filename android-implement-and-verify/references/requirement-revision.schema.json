{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement-revision.schema.json",
  "title": "Android Delivery Requirement Revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requirement_id", "base_revision", "scope", "changes"],
  "properties": {
    "version": { "const": 1 },
    "requirement_id": { "type": "string", "minLength": 1 },
    "base_revision": { "type": "integer", "minimum": 0 },
    "scope": { "enum": ["SAME_REQUIREMENT", "NEW_SERIAL_REQUIREMENT"] },
    "format_only": { "type": "boolean" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "change_type", "decision"],
        "properties": {
          "id": { "type": "string", "pattern": "^BDD-[0-9]+/T[0-9]+$" },
          "change_type": {
            "enum": ["ADDED", "CHANGED", "REMOVED", "UNCHANGED", "SUPERSEDED"]
          },
          "decision": { "enum": ["CONFIRMED", "PENDING", "REJECTED", "CONFLICT"] },
          "text": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "disposition": {
            "enum": ["REMOVE_IMPLEMENTATION", "KEEP_COMPATIBILITY", "STOP_UNFINISHED_WORK"]
          },
          "replacement_id": { "type": "string", "pattern": "^BDD-[0-9]+/T[0-9]+$" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "change_type": { "enum": ["ADDED", "CHANGED"] } },
              "required": ["change_type"]
            },
            "then": { "required": ["text", "required"] }
          },
          {
            "if": {
              "properties": {
                "change_type": { "const": "REMOVED" },
                "decision": { "const": "CONFIRMED" }
              },
              "required": ["change_type", "decision"]
            },
            "then": { "required": ["disposition"] }
          },
          {
            "if": {
              "properties": {
                "change_type": { "const": "SUPERSEDED" },
                "decision": { "const": "CONFIRMED" }
              },
              "required": ["change_type", "decision"]
            },
            "then": { "required": ["replacement_id"] }
          },
          {
            "if": {
              "properties": {
                "decision": { "enum": ["PENDING", "REJECTED", "CONFLICT"] }
              },
              "required": ["decision"]
            },
            "then": { "required": ["reason"] }
          }
        ]
      }
    }
  }
}
