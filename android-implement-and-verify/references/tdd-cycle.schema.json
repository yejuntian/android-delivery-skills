{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Android Delivery TDD Cycle",
  "type": "object",
  "required": [
    "version",
    "producer",
    "cycle_id",
    "status",
    "requirement_id",
    "requirement_revision",
    "requirement_file_sha256",
    "requirement_inputs_sha256",
    "test_mapping_sha256",
    "obligations",
    "red",
    "green"
  ],
  "properties": {
    "version": { "const": 1 },
    "producer": { "const": "android-delivery-tdd-cycle" },
    "cycle_id": { "type": "string", "minLength": 1 },
    "status": { "const": "GREEN" },
    "requirement_id": { "type": "string", "minLength": 1 },
    "requirement_revision": { "type": "integer", "minimum": 0 },
    "requirement_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirement_inputs_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "test_mapping_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "obligation_sha256", "test_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^BDD-[0-9]{3}$" },
          "obligation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "test_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "red": { "$ref": "#/$defs/phase" },
    "green": { "$ref": "#/$defs/phase" }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": [
        "receipt_path",
        "receipt_sha256",
        "receipt_id",
        "command_sha256",
        "snapshot_sha256_before",
        "snapshot_sha256_after",
        "started_at",
        "finished_at",
        "test_source_sha256",
        "test_source_files",
        "executed_test_ids"
      ],
      "properties": {
        "receipt_path": { "type": "string", "minLength": 1 },
        "receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "receipt_id": { "type": "string", "minLength": 1 },
        "command_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "snapshot_sha256_before": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "snapshot_sha256_after": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "test_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "test_source_files": { "type": "array" },
        "executed_test_ids": { "type": "array", "items": { "type": "string" } },
        "failed_test_ids": { "type": "array", "items": { "type": "string" } },
        "passed_test_ids": { "type": "array", "items": { "type": "string" } },
        "failure_kind": { "const": "ASSERTION" }
      }
    }
  }
}
