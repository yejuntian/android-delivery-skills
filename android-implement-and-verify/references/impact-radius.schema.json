{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "impact-radius.schema.json",
  "title": "Android Delivery Incremental Impact Radius",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "requirement_id",
    "requirement_revision",
    "requirement_file_sha256",
    "requirement_summary_sha256",
    "allowed_files",
    "allowed_globs",
    "impacts"
  ],
  "properties": {
    "version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "requirement_id": { "type": "string", "minLength": 1 },
    "requirement_revision": { "type": "integer", "minimum": 1 },
    "requirement_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirement_summary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "allowed_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "allowed_globs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "no_code_change_reason": { "type": "string", "minLength": 1 },
    "impacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/impact" }
    }
  },
  "$defs": {
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "change_type",
        "reason",
        "risk_level",
        "expected_files",
        "expected_tests",
        "affected_modules"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^BDD-[0-9]+/T[0-9]+$" },
        "change_type": {
          "enum": ["ADDED", "CHANGED", "REMOVED", "SUPERSEDED"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "risk_level": { "enum": ["L1", "L2", "L3", "BLOCKED"] },
        "expected_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "expected_tests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "affected_modules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "no_code_change_reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
