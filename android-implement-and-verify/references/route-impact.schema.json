{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route-impact.schema.json",
  "title": "Android Delivery Route Impact Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "requirement_id",
    "requirement_revision",
    "requirement_file_sha256",
    "requirement_inputs_sha256",
    "implementation_plan_sha256",
    "impact_radius_sha256",
    "plan_confirmation_receipt_sha256",
    "baseline_id",
    "snapshot_sha256",
    "route_session",
    "route_round",
    "max_route_rounds",
    "route_context_sha256",
    "route_input_sha256",
    "previous_route_input_sha256",
    "convergence_status",
    "impact_candidates",
    "specialist_tasks",
    "conditional_gates"
  ],
  "properties": {
    "version": { "const": 6 },
    "generated_at": { "type": "string", "format": "date-time" },
    "requirement_id": { "type": "string", "minLength": 1 },
    "requirement_revision": { "type": "integer", "minimum": 1 },
    "requirement_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirement_inputs_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "implementation_plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "impact_radius_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plan_confirmation_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseline_id": { "type": "string", "minLength": 1 },
    "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "route_session": { "type": "integer", "minimum": 1 },
    "route_round": { "type": "integer", "minimum": 1 },
    "max_route_rounds": { "type": "integer", "minimum": 1 },
    "route_context_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "route_input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previous_route_input_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "convergence_status": {
      "enum": ["INITIAL", "CHANGED", "STABLE", "BLOCKED"]
    },
    "impact_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ui", "api", "data", "system", "build", "architecture", "tests"],
      "properties": {
        "ui": { "$ref": "#/$defs/candidate_files" },
        "api": { "$ref": "#/$defs/candidate_files" },
        "data": { "$ref": "#/$defs/candidate_files" },
        "system": { "$ref": "#/$defs/candidate_files" },
        "build": { "$ref": "#/$defs/candidate_files" },
        "architecture": { "$ref": "#/$defs/candidate_files" },
        "tests": { "$ref": "#/$defs/candidate_files" }
      }
    },
    "specialist_tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/specialist_task" }
    },
    "conditional_gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "candidate_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "specialist_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "gate_id", "required", "status", "basis_files", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^TASK-.+" },
        "skill": {
          "enum": [
            "android-review-diff",
            "android-review-code-quality",
            "android-audit-stability",
            "android-test-and-fix",
            "android-verify-api-contract",
            "android-verify-ui"
          ]
        },
        "gate_id": {
          "enum": [
            "android-review-diff",
            "android-review-code-quality",
            "android-audit-stability",
            "android-test-and-fix",
            "android-verify-api-contract",
            "android-ui-a11y"
          ]
        },
        "required": { "const": true },
        "status": { "const": "PENDING" },
        "basis_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "basis_files"],
      "properties": {
        "id": {
          "enum": [
            "android-verify-api-contract",
            "android-data-migration",
            "android-ui-a11y",
            "android-security-privacy"
          ]
        },
        "basis_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
