{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specialist-result.schema.json",
  "title": "Android Delivery Specialist Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "producer",
    "id",
    "skill",
    "provenance",
    "requirement_id",
    "requirement_revision",
    "requirement_file_sha256",
    "requirement_inputs_sha256",
    "baseline_id",
    "snapshot_sha256",
    "conclusion",
    "summary",
    "findings",
    "unresolved_findings",
    "obligation_sha256s"
  ],
  "properties": {
    "version": { "const": 4 },
    "producer": { "const": "android-delivery-specialist-result" },
    "id": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill"],
      "properties": {
        "skill": { "type": "string", "minLength": 1 }
      }
    },
    "requirement_id": { "type": "string", "minLength": 1 },
    "requirement_revision": { "type": "integer", "minimum": 1 },
    "requirement_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirement_inputs_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseline_id": { "type": "string", "minLength": 1 },
    "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conclusion": { "enum": ["PASS", "FAIL", "SKIPPED", "UNVERIFIED", "BLOCKED"] },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3"],
      "properties": {
        "P0": { "type": "integer", "minimum": 0 },
        "P1": { "type": "integer", "minimum": 0 },
        "P2": { "type": "integer", "minimum": 0 },
        "P3": { "type": "integer", "minimum": 0 }
      }
    },
    "unresolved_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "summary"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "static_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "scope_files",
        "tools",
        "control_audit_path",
        "control_audit_sha256",
        "control_changes",
        "finding_ids"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "items": { "enum": ["KOTLIN", "JAVA", "MIXED", "NONE"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "scope_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "version", "mode", "scope", "cross_file"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["PASS", "FAIL", "SKIPPED", "UNVERIFIED", "BLOCKED"] },
              "version": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["COMPILER", "TYPE_RESOLVED", "SYNTAX_ONLY", "BYTECODE", "DATAFLOW", "UNKNOWN"] },
              "scope": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "cross_file": { "type": ["boolean", "null"] },
              "reason": { "type": "string", "minLength": 1 },
              "evidence_path": { "type": "string", "minLength": 1 },
              "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "status": { "const": "PASS" } },
                  "required": ["status"]
                },
                "then": { "required": ["evidence_path", "evidence_sha256"] },
                "else": { "required": ["reason"] }
              }
            ]
          }
        },
        "control_audit_path": { "type": "string", "minLength": 1 },
        "control_audit_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "control_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "kind", "decision", "reason"],
            "properties": {
              "id": { "type": "string", "pattern": "^CTL-[A-F0-9]{16}$" },
              "path": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["SUPPRESSION", "BASELINE", "EXCLUSION", "CONFIG"] },
              "decision": { "enum": ["JUSTIFIED", "REMOVED", "BLOCKING"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "finding_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^FND-[A-F0-9]{16}$" },
          "uniqueItems": true
        }
      }
    },
    "confirmed_impacts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "applicable", "basis_files", "reason"],
        "properties": {
          "id": { "enum": ["ui", "api", "data", "system", "build", "architecture", "tests"] },
          "applicable": { "type": "boolean" },
          "basis_files": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "reason": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "applicable": { "const": true } },
              "required": ["applicable"]
            },
            "then": { "properties": { "basis_files": { "minItems": 1 } } },
            "else": { "properties": { "basis_files": { "maxItems": 0 } } }
          }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "enum": ["PASS", "FAIL", "SKIPPED", "UNVERIFIED", "BLOCKED"] },
          "reason": { "type": "string" }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "status", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "enum": ["PASS", "FAIL", "SKIPPED", "UNVERIFIED", "BLOCKED"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "kind": { "type": "string" }
        }
      }
    },
    "visual_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design_links": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_links": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "diff_links": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dynamic_notes": { "type": "string", "minLength": 1 }
      }
    },
    "device_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["READY", "UNAVAILABLE", "BLOCKED"] },
        "serial": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["PHYSICAL", "EMULATOR"] },
        "screenshot_ok": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "READY" } },
            "required": ["status"]
          },
          "then": {
            "required": ["serial", "kind", "screenshot_ok"],
            "properties": {
              "kind": { "const": "PHYSICAL" },
              "screenshot_ok": { "const": true }
            }
          },
          "else": {
            "required": ["reason"]
          }
        }
      ]
    },
    "executed_checks": { "type": "integer", "minimum": 0 },
    "executed_tests": { "type": ["integer", "null"], "minimum": 0 },
    "obligation_sha256s": {
      "type": "object",
      "propertyNames": { "pattern": "^BDD-[0-9]+$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "skill": { "const": "android-review-diff" }
        },
        "required": ["skill"]
      },
      "then": {
        "required": ["confirmed_impacts"]
      },
      "else": {
        "not": { "required": ["confirmed_impacts"] }
      }
    },
    {
      "if": {
        "properties": {
          "skill": { "const": "android-review-code-quality" }
        },
        "required": ["skill"]
      },
      "then": {
        "required": ["checks", "executed_checks"],
        "properties": {
          "checks": {
            "minItems": 4,
            "allOf": [
              { "contains": { "properties": { "id": { "const": "architecture-layering" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "responsibility-cohesion" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "source-documentation" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "dependency-testability" } }, "required": ["id"] } }
            ]
          },
          "executed_checks": { "minimum": 4 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "skill": { "const": "android-verify-api-contract" }
        },
        "required": ["skill"]
      },
      "then": {
        "required": ["capabilities", "checks", "executed_checks", "artifacts"],
        "properties": {
          "capabilities": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": ["id", "required"],
              "properties": {
                "id": { "const": "api-contract" },
                "required": { "const": true }
              }
            }
          },
          "checks": {
            "minItems": 3,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "id": { "const": "contract-source" },
                    "required": { "const": true }
                  },
                  "required": ["id", "required"]
                }
              },
              {
                "contains": {
                  "properties": {
                    "id": { "const": "operation-schema" },
                    "required": { "const": true }
                  },
                  "required": ["id", "required"]
                }
              },
              {
                "contains": {
                  "properties": {
                    "id": { "const": "implementation-mapping" },
                    "required": { "const": true }
                  },
                  "required": ["id", "required"]
                }
              }
            ]
          },
          "executed_checks": { "minimum": 3 },
          "artifacts": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "skill": { "const": "android-test-and-fix/journey-agent" }
        },
        "required": ["skill"]
      },
      "then": {
        "required": [
          "capabilities",
          "commands",
          "checks",
          "artifacts",
          "executed_checks",
          "executed_tests",
          "started_at",
          "finished_at"
        ],
        "properties": {
          "capabilities": { "minItems": 1 },
          "commands": { "minItems": 1 },
          "checks": { "minItems": 1 },
          "artifacts": { "minItems": 1 },
          "executed_checks": { "minimum": 1 },
          "executed_tests": { "type": "integer", "minimum": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "skill": { "const": "android-audit-stability" }
        },
        "required": ["skill"]
      },
      "then": {
        "required": ["capabilities", "checks", "executed_checks", "static_analysis"],
        "properties": {
          "capabilities": {
            "minItems": 4,
            "allOf": [
              { "contains": { "properties": { "id": { "const": "android-static-semantics" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "android-dynamic-leak" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "android-performance" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "android-security-privacy" } }, "required": ["id"] } }
            ]
          },
          "checks": {
            "minItems": 7,
            "allOf": [
              { "contains": { "properties": { "id": { "const": "static-short-lifetime-ownership" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "static-registration-pairing" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "static-resource-pairing" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "static-async-lifetime" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "static-cleanup-reachability" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "static-concurrency-discipline" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "static-control-changes" } }, "required": ["id"] } }
            ]
          },
          "executed_checks": { "minimum": 7 },
          "unresolved_findings": {
            "items": {
              "required": ["id"],
              "properties": {
                "id": { "type": "string", "pattern": "^FND-[A-F0-9]{16}$" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "skill": { "const": "android-verify-ui" }
        },
        "required": ["skill"]
      },
      "then": {
        "properties": {
          "artifacts": { "maxItems": 0 }
        },
        "if": {
          "properties": { "conclusion": { "const": "PASS" } },
          "required": ["conclusion"]
        },
        "then": { "required": ["visual_review", "device_check"] }
      },
      "else": {
        "not": { "anyOf": [{ "required": ["visual_review"] }, { "required": ["device_check"] }] }
      }
    }
  ]
}
