{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation-plan-receipt.schema.json",
  "title": "Android Delivery Implementation Plan Confirmation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "confirmed_at",
    "requirement_id",
    "requirement_revision",
    "requirement_file_sha256",
    "requirement_summary_sha256",
    "implementation_plan_path",
    "implementation_plan_sha256",
    "impact_radius_path",
    "impact_radius_sha256"
  ],
  "properties": {
    "version": { "const": 1 },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "requirement_id": { "type": "string", "minLength": 1 },
    "requirement_revision": { "type": "integer", "minimum": 1 },
    "requirement_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirement_summary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "implementation_plan_path": { "type": "string", "minLength": 1 },
    "implementation_plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "impact_radius_path": { "type": "string", "minLength": 1 },
    "impact_radius_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
