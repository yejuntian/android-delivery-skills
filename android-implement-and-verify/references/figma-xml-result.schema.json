{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figma-xml-result.schema.json",
  "title": "Figma Android XML Handoff Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "producer",
    "requirement_id",
    "requirement_revision",
    "requirement_inputs_sha256",
    "ui_technology",
    "source",
    "files",
    "semantic_change",
    "assumptions",
    "validation"
  ],
  "properties": {
    "version": { "const": 1 },
    "producer": { "const": "figma-android-xml" },
    "requirement_id": { "type": "string", "minLength": 1 },
    "requirement_revision": { "type": "integer", "minimum": 1 },
    "requirement_inputs_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ui_technology": { "enum": ["XML", "MIXED_XML_PAGE"] },
    "module": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_links", "node_ids", "source_sha256"],
      "properties": {
        "design_links": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "node_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["LAYOUT", "DRAWABLE", "VALUES", "FONT", "BITMAP", "OTHER_RESOURCE"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "semantic_change": { "enum": ["NONE", "VISUAL_ONLY", "BEHAVIOR_CHANGE", "UNKNOWN"] },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["PASS", "FAIL", "UNVERIFIED", "BLOCKED"] },
          "receipt": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
