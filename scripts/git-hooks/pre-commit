#!/bin/sh
# Android Delivery maintenance pre-commit template.
# Install with: python3 scripts/install_maintenance_hook.py
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "Android Delivery 维护验证：无法定位 Git 根目录" >&2
  exit 2
}

for SKILL_DIR in \
  "$ROOT/ai-skills/android-delivery-skills" \
  "$ROOT/android-delivery-skills" \
  "$ROOT"
do
  if [ -f "$SKILL_DIR/scripts/maintenance_pre_commit.py" ]; then
    exec python3 "$SKILL_DIR/scripts/maintenance_pre_commit.py" --skill-dir "$SKILL_DIR" "$@"
  fi
done

echo "Android Delivery 维护验证：未找到 scripts/maintenance_pre_commit.py" >&2
exit 2
